# Produção: URL pública do backend (Render), sem barra no final.
# Ex.: VITE_API_URL=https://futpro-api.onrender.com
#
# Desenvolvimento: deixe vazio ou omita — o Vite encaminha /api para localhost:3333.
# VITE_API_URL=

# Sentry (plano gratuito): DSN do projeto frontend.
# Ex.: VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>
# VITE_SENTRY_DSN=
